# ==============================================================================
# SoCo Social Media Strategist — Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Vertex AI & Gemini Configuration
# ------------------------------------------------------------------------------
# Use Vertex AI with Application Default Credentials (gcloud auth application-default login)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
SOCO_PRIMARY_MODEL=gemini-3.8-flash

# Alternatively, to run with Google AI Studio standalone API key:
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# ------------------------------------------------------------------------------
# Cryptographic secret for signing session tokens (min 32 characters)
# In production, this is injected securely via Google Cloud Secret Manager
SOCO_AUTH_SECRET=replace-with-a-secure-random-secret-min-32-chars

# Initial private beta invitation codes (Format: CODE:max_uses:notes,CODE2:...)
# Leave blank to use safe local development placeholder keys
SOCO_INITIAL_INVITATION_CODES=SOCO-DEV-MASTER-KEY:10:DevMasterKey,SOCO-DEV-COHORT-KEY:5:DevCohortKey

# Enable sandbox industry demo login without credentials (true for beta/portfolio)
ALLOW_DEMO_LOGIN=true

# ------------------------------------------------------------------------------
# 3. Environment & Spending Safeguards
# ------------------------------------------------------------------------------
ENVIRONMENT=development
# Hard monthly spending cap in USD before automatic AI request suspension
# AUTOMATIC_SUSPENSION_USD=20.00
# Target monthly budget in USD
# MONTHLY_TARGET_BUDGET_USD=25.00
